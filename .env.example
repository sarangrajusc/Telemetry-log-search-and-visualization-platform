# Copy to .env for local use. .env is gitignored. NEVER commit real values.

# --- Auth ---
API_KEY=change-me-to-a-long-random-string      # generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PROTECT_READS=1                                # also require the key on search/stats/investigate

# --- CORS (empty = disabled; the bundled dashboard is same-origin) ---
CORS_ORIGINS=

# --- Storage ---
STORAGE_BACKEND=sqlite                         # or: elasticsearch
# ES_URL=http://localhost:9200
# ES_API_KEY=
# ES_INDEX=telemetry-logs

# --- Tuning ---
CACHE_TTL_SECONDS=15
INVESTIGATE_WORKERS=8
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
REDACT_SECRETS=1

# --- Alerting ---
ERROR_RATE_THRESHOLD=0.1
ALERT_WINDOW_MINUTES=15
# ALERT_WEBHOOK_URL=
